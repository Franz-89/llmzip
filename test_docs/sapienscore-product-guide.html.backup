<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SapiensCore — The Intelligent Platform for Entertainment Venues</title>
    <style>
        /* =========================================
           RESET & BASE
           ========================================= */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --primary: #1a237e;
            --primary-light: #283593;
            --primary-dark: #0d1342;
            --accent: #00bcd4;
            --accent-light: #4dd0e1;
            --accent-dark: #00838f;
            --text: #263238;
            --text-light: #546e7a;
            --text-muted: #78909c;
            --bg: #ffffff;
            --bg-light: #f5f7fa;
            --bg-section: #fafbfc;
            --border: #e0e6ed;
            --success: #2e7d32;
            --warning: #f57f17;
            --danger: #c62828;
        }

        @page {
            size: A4;
            margin: 20mm 18mm 25mm 18mm;
        }

        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif;
            color: var(--text);
            line-height: 1.65;
            font-size: 10.5pt;
            background: #eef1f5;
        }

        /* =========================================
           PAGE LAYOUT
           ========================================= */
        .page {
            width: 210mm;
            min-height: 277mm;
            margin: 20px auto;
            padding: 40px 48px 60px 48px;
            background: var(--bg);
            position: relative;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        .page-break {
            page-break-after: always;
        }

        .page-footer {
            position: absolute;
            bottom: 22px;
            left: 48px;
            right: 48px;
            font-size: 7.5pt;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            padding-top: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-footer .confidential {
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 6.5pt;
        }

        /* =========================================
           TYPOGRAPHY
           ========================================= */
        h1 {
            font-size: 28pt;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.5px;
            line-height: 1.2;
        }

        h2 {
            font-size: 18pt;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 3px solid var(--accent);
            display: inline-block;
        }

        h3 {
            font-size: 13pt;
            font-weight: 600;
            color: var(--primary-light);
            margin-top: 20px;
            margin-bottom: 10px;
        }

        h4 {
            font-size: 11pt;
            font-weight: 600;
            color: var(--text);
            margin-top: 14px;
            margin-bottom: 6px;
        }

        p {
            margin-bottom: 10px;
        }

        .lead {
            font-size: 12pt;
            color: var(--text-light);
            line-height: 1.7;
        }

        .subtitle {
            font-size: 14pt;
            color: var(--accent-dark);
            font-weight: 400;
            letter-spacing: 0.3px;
        }

        .tagline {
            font-size: 11pt;
            color: var(--text-muted);
            font-style: italic;
            letter-spacing: 0.5px;
        }

        /* =========================================
           COVER PAGE
           ========================================= */
        .cover {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-height: 260mm;
            padding: 0;
        }

        .cover-logo {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 40px;
            box-shadow: 0 8px 32px rgba(26, 35, 126, 0.25);
        }

        .cover-logo-text {
            color: white;
            font-size: 36pt;
            font-weight: 800;
            letter-spacing: -2px;
        }

        .cover h1 {
            font-size: 42pt;
            margin-bottom: 12px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .cover .subtitle {
            font-size: 16pt;
            margin-bottom: 8px;
        }

        .cover .tagline {
            font-size: 12pt;
            margin-bottom: 60px;
        }

        .cover-meta {
            margin-top: 60px;
            font-size: 9pt;
            color: var(--text-muted);
            line-height: 1.8;
        }

        .cover-line {
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            margin: 24px auto;
            border-radius: 2px;
        }

        /* =========================================
           TABLE OF CONTENTS
           ========================================= */
        .toc-entry {
            display: flex;
            align-items: baseline;
            padding: 6px 0;
            border-bottom: 1px dotted var(--border);
        }

        .toc-entry:last-child { border-bottom: none; }

        .toc-number {
            width: 36px;
            flex-shrink: 0;
            font-weight: 700;
            color: var(--accent-dark);
            font-size: 10pt;
        }

        .toc-title {
            flex: 1;
            font-size: 10.5pt;
            color: var(--text);
        }

        .toc-page {
            flex-shrink: 0;
            font-size: 10pt;
            color: var(--text-muted);
            margin-left: 8px;
        }

        .toc-section {
            margin-top: 18px;
            margin-bottom: 6px;
            font-size: 12pt;
            font-weight: 700;
            color: var(--primary);
            padding-bottom: 4px;
            border-bottom: 2px solid var(--accent);
            display: inline-block;
        }

        /* =========================================
           CONTENT ELEMENTS
           ========================================= */
        .highlight-box {
            background: linear-gradient(135deg, #e8eaf6 0%, #e0f7fa 100%);
            border-left: 4px solid var(--accent);
            padding: 16px 20px;
            margin: 16px 0;
            border-radius: 0 8px 8px 0;
            font-size: 10pt;
        }

        .highlight-box p:last-child { margin-bottom: 0; }

        .highlight-box.primary {
            background: linear-gradient(135deg, #e8eaf6 0%, #ede7f6 100%);
            border-left-color: var(--primary);
        }

        .highlight-box.success {
            background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
            border-left-color: var(--success);
        }

        .value-prop {
            background: var(--bg-light);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px 20px;
            margin: 14px 0;
        }

        .value-prop-title {
            font-weight: 700;
            color: var(--primary);
            font-size: 10.5pt;
            margin-bottom: 4px;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin: 16px 0;
        }

        .stat-card {
            text-align: center;
            padding: 18px 10px;
            border-radius: 8px;
            background: var(--bg-light);
            border: 1px solid var(--border);
        }

        .stat-number {
            font-size: 22pt;
            font-weight: 800;
            color: var(--primary);
            line-height: 1.1;
        }

        .stat-label {
            font-size: 8pt;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 4px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin: 14px 0;
        }

        .feature-item {
            padding: 12px 14px;
            background: var(--bg-light);
            border-radius: 6px;
            border: 1px solid var(--border);
            font-size: 9.5pt;
        }

        .feature-item-title {
            font-weight: 600;
            color: var(--primary-light);
            font-size: 10pt;
            margin-bottom: 3px;
        }

        ul.clean {
            list-style: none;
            padding: 0;
            margin: 8px 0;
        }

        ul.clean li {
            padding: 4px 0 4px 18px;
            position: relative;
            font-size: 10pt;
        }

        ul.clean li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 11px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
        }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
            font-size: 9.5pt;
        }

        table.data-table th {
            background: var(--primary);
            color: white;
            padding: 8px 12px;
            text-align: left;
            font-weight: 600;
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        table.data-table th:first-child { border-radius: 6px 0 0 0; }
        table.data-table th:last-child { border-radius: 0 6px 0 0; }

        table.data-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--border);
            vertical-align: top;
        }

        table.data-table tr:nth-child(even) td {
            background: var(--bg-light);
        }

        table.data-table tr:last-child td {
            border-bottom: 2px solid var(--primary);
        }

        .flow-diagram {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            margin: 16px 0;
            flex-wrap: wrap;
        }

        .flow-step {
            background: var(--primary);
            color: white;
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 8.5pt;
            font-weight: 600;
            text-align: center;
            min-width: 80px;
        }

        .flow-arrow {
            color: var(--accent);
            font-size: 16pt;
            font-weight: 700;
            line-height: 1;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 12px 0;
        }

        .section-intro {
            font-size: 11pt;
            color: var(--text-light);
            margin-bottom: 16px;
            line-height: 1.7;
        }

        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 8pt;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .badge-primary { background: #e8eaf6; color: var(--primary); }
        .badge-accent { background: #e0f7fa; color: var(--accent-dark); }
        .badge-success { background: #e8f5e9; color: var(--success); }

        .divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--border), transparent);
            margin: 20px 0;
        }

        .icon-bullet {
            display: inline-block;
            width: 24px;
            height: 24px;
            line-height: 24px;
            text-align: center;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            font-size: 11px;
            font-weight: 700;
            margin-right: 8px;
            flex-shrink: 0;
            vertical-align: middle;
        }

        .chapter-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            margin: -40px -48px 30px -48px;
            padding: 30px 48px;
        }

        .chapter-header h2 {
            color: white;
            border-bottom-color: var(--accent);
            margin-bottom: 8px;
        }

        .chapter-header p {
            color: rgba(255,255,255,0.85);
            font-size: 11pt;
        }

        .chapter-number {
            font-size: 9pt;
            font-weight: 700;
            color: var(--accent-light);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 4px;
        }

        /* =========================================
           PRINT STYLES
           ========================================= */
        @media print {
            body {
                background: white;
                font-size: 10pt;
            }
            .page {
                width: auto;
                min-height: auto;
                margin: 0;
                padding: 0;
                box-shadow: none;
            }
            .page-break {
                page-break-after: always;
            }
            .page-footer {
                position: fixed;
                bottom: 0;
                left: 18mm;
                right: 18mm;
            }
            .chapter-header {
                margin: 0 0 20px 0;
                padding: 20px 0;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            .stat-card, .feature-item, .highlight-box, .value-prop, table.data-table th {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>

